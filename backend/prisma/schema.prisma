generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String
  password  String
  role      String   @default("customer")
  createdAt DateTime @default(now())
  orders    Order[]
  roleChanges RoleChange[] @relation("RoleChangeActor")
  settingsChanges StoreSettingsChange[] @relation("SettingsChangeActor")
  deliveryChanges DeliverySettingsChange[] @relation("DeliveryChangeActor")
  notifications Notification[]
  savedAddresses CustomerAddress[]
}

// Address book is private to one user. Order address fields are immutable snapshots.
model CustomerAddress {
  id        String   @id @default(cuid())
  userId    String
  label     String
  name      String
  phone     String
  city      String
  address   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId,isDefault])
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String
  price       Int
  usdPrice    Int
  category    String
  brand       String
  icon        String
  image       String?
  gallery     String? // JSON array of additional image URLs, maximum 5
  specs       String? // JSON array of {label,value}, maximum 12
  sku         String?     @unique // Optional normalized SKU, unique across products
  model       String? // Manufacturer model number
  size        String? // Size, variant or dimensions
  saleUnit    String? // piece, box, set, pack, pair, bottle, tube, carton, bag, roll
  published   Boolean     @default(true) // Hidden products stay in inventory/history but cannot be newly ordered
  lotTracking Boolean     @default(false) // Opt-in only for zero-stock products with no historical movements
  lots        ProductLot[]
  badge       String?
  stock       Int         @default(0)
  createdAt   DateTime    @default(now())
  orderItems  OrderItem[]
  inventoryMovements InventoryMovement[]
}

model Category {
  id   String @id @default(cuid())
  name String @unique
  icon String
}

model Coupon {
  id          String   @id @default(cuid())
  code        String   @unique
  discount    Int
  active      Boolean  @default(true)
  kind        String   @default("percent")
  minSubtotal Int      @default(0)
  maxUses     Int?
  usedCount   Int      @default(0)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
}

model Order {
  id              String      @id @default(cuid())
  userId          String?
  customerName    String
  customerPhone   String
  customerAddress String
  customerCity    String
  total           Int
  subtotal        Int?
  shippingFee     Int?
  couponCode      String?
  discountAmount  Int?
  status          String      @default("pending")
  paymentMethod   String      @default("cod")
  createdAt       DateTime    @default(now())
  user            User?       @relation(fields: [userId], references: [id])
  items           OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
  lotAllocations OrderItemLot[]
}

// Each physical batch belongs to one product. Expiry is a date-only YYYY-MM-DD
// in Iraq local calendar; remaining batch stock includes expired/non-sellable units.
model ProductLot {
  id         String   @id @default(cuid())
  productId  String
  code       String
  expiryDate String
  stock      Int      @default(0)
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  allocations OrderItemLot[]

  @@unique([productId, code])
  @@index([productId, expiryDate])
}

model OrderItemLot {
  id          String    @id @default(cuid())
  orderItemId String
  lotId       String
  quantity    Int
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  lot         ProductLot @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@unique([orderItemId, lotId])
  @@index([lotId])
}

// Append-only record of every stock change. It is NOT a replacement for Product.stock;
// each movement and its matching balance update are saved in one transaction.
model InventoryMovement {
  id          String   @id @default(cuid())
  productId   String
  delta       Int
  before      Int
  after       Int
  reason      String
  referenceId String?
  actorId     String?
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@index([referenceId])
}

model RoleChange {
  id           String   @id @default(cuid())
  actorId      String
  targetId     String
  previousRole String
  newRole      String
  createdAt    DateTime @default(now())
  actor        User     @relation("RoleChangeActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([targetId, createdAt])
}

// Public storefront settings. One row with id="main"; no private keys stored here.
model StoreSettings {
  id              String   @id @default("main")
  siteName        String   @default("ثنايا")
  siteDescription String   @default("متجر عراقي للمستلزمات الطبية وطب الأسنان والأجهزة")
  phone           String   @default("07822088894")
  email           String   @default("info@thanaya.iq")
  address         String   @default("البصرة - حي الخضراء - شارع مستشفى النفط")
  workingHours    String   @default("السبت - الخميس: 12 ظهراً - 9 مساءً")
  usdToIqdRate    Int?
  showUsdApprox   Boolean  @default(false)
  bannerEnabled   Boolean  @default(true)
  bannerEyebrow   String   @default("THANAYA / BASRA")
  bannerTitle     String   @default("احتياجات عيادتك، أسهل مع ثنايا.")
  bannerDescription String @default("تصفّح مستلزمات طب الأسنان والأجهزة الطبية، ورتّب احتياجاتك من الأقسام الموجودة في المتجر.")
  bannerButtonLabel String @default("ابدأ التصفّح")
  bannerButtonHref String  @default("/products")
  bannerImage     String?
  revision        Int      @default(0)
  updatedAt       DateTime @updatedAt
}

// Audit who changed non-secret public settings, without changing past orders.
model StoreSettingsChange {
  id        String   @id @default(cuid())
  actorId   String
  before    String
  after     String
  createdAt DateTime @default(now())
  actor     User     @relation("SettingsChangeActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt])
}

// Delivery is off until the owner configures at least one governorate.
model DeliveryConfig {
  id        String   @id @default("main")
  enabled   Boolean  @default(false)
  revision  Int      @default(0)
  updatedAt DateTime @updatedAt
}

model DeliveryRate {
  province  String  @id
  fee       Int     @default(0)
  available Boolean @default(false)
}

model DeliverySettingsChange {
  id        String   @id @default(cuid())
  actorId   String
  before    String
  after     String
  createdAt DateTime @default(now())
  actor     User     @relation("DeliveryChangeActor", fields: [actorId], references: [id], onDelete: Restrict)
  @@index([createdAt])
}

// In-app notifications have individual recipients and independent read state.
// Only events after this table is deployed are recorded; old orders are unchanged.
model Notification {
  id          String    @id @default(cuid())
  recipientId String
  kind        String
  title       String
  message     String
  orderId     String?
  createdAt   DateTime  @default(now())
  readAt      DateTime?
  recipient   User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
}
